\<script>
// ====== CONFIGURÁVEL ======
const WHATSAPP_NUMBER = "5511930278918"; // (11) 93027-8918
const SERVICES = [
&#x20; {name:"Corte", desc:"Corte masculino com acabamento profissional.", price:"R$ XX,XX"},
&#x20; {name:"Barba", desc:"Toalha quente, navalha e finalização.", price:"R$ XX,XX"},
&#x20; {name:"Corte + Barba", desc:"Combo completo.", price:"R$ XX,XX"},
&#x20; {name:"Degradê", desc:"Fade com acabamento na navalha.", price:"R$ XX,XX"},
&#x20; {name:"Sobrancelha", desc:"Design na navalha ou pinça.", price:"R$ XX,XX"},
&#x20; {name:"Pigmentação", desc:"Barba ou cabelo.", price:"R$ XX,XX"}
]; // <- confirme nomes e valores reais com a Bronx's
const TIME_SLOTS = ["09:00","10:00","11:00","13:00","14:00","15:00","16:00","17:00","18:00","19:00"];
// ===========================

function waLink(text){ return "[https://wa.me/](https://wa.me/)" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(text); }
document.getElementById('heroWhats').href = waLink("Olá! Encontrei a Barbearia Bronx's pelo site e gostaria de agendar um horário.");
document.getElementById('footWhats').href = waLink("Olá! Encontrei a Barbearia Bronx's pelo site e gostaria de falar com vocês.");
document.getElementById('fabWhats').href = waLink("Olá! Encontrei a Barbearia Bronx's pelo site.");

// Services
const svcGrid = document.getElementById('svcGrid');
const fService = document.getElementById('fService');
SERVICES.forEach(s=>{
&#x20; const card = document.createElement('div');
&#x20; card.className = 'svc-card reveal';
&#x20; card.innerHTML = \`\<h3>${s.name}\</h3>\<p>${s.desc}\</p>\<div class="price">${s.price}\</div>
&#x20;   \<a class="btn btn-outline" href="${waLink('Olá! Gostaria de agendar: '+s.name)}" target="\_blank">Agendar\</a>\`;
&#x20; svcGrid.appendChild(card);
&#x20; const opt = document.createElement('option');
&#x20; opt.textContent = s.name + " — " + s.price;
&#x20; fService.appendChild(opt);
});

// Date
const fDate = document.getElementById('fDate');
const todayStr = new Date().toISOString().slice(0,10);
fDate.value = todayStr; fDate.min = todayStr;

// Slots (session-only availability)
const taken = {}; let selectedSlot = null;
function renderSlots(){
&#x20; const box = document.getElementById('slotsBox');
&#x20; box.innerHTML = "";
&#x20; const key = fDate.value;
&#x20; const set = taken[key] || new Set();
&#x20; selectedSlot = null;
&#x20; TIME_SLOTS.forEach(t=>{
&#x20;   const d = document.createElement('div');
&#x20;   d.className = 'slot' + (set.has(t) ? ' taken' : '');
&#x20;   d.textContent = t;
&#x20;   if(!set.has(t)){
&#x20;     d.addEventListener('click', ()=>{
&#x20;       document.querySelectorAll('.slot').forEach(s=>s.classList.remove('selected'));
&#x20;       d.classList.add('selected'); selectedSlot = t;
&#x20;     });
&#x20;   }
&#x20;   box.appendChild(d);
&#x20; });
}
fDate.addEventListener('change', renderSlots);
renderSlots();

document.getElementById('submitBooking').addEventListener('click', ()=>{
&#x20; const name = document.getElementById('fName').value.trim();
&#x20; const phone = document.getElementById('fPhone').value.trim();
&#x20; const service = fService.value;
&#x20; const date = fDate.value;
&#x20; if(!name){ alert("Digite seu nome."); return; }
&#x20; if(!selectedSlot){ alert("Escolha um horário disponível."); return; }
&#x20; const key = date;
&#x20; if(!taken[key]) taken[key] = new Set();
&#x20; taken[key].add(selectedSlot);
&#x20; renderSlots();
&#x20; const msg = \`Olá, Barbearia Bronx's! Gostaria de agendar um horário.\n\nNome: ${name}\nTelefone: ${phone}\nServiço: ${service}\nData: ${date}\nHorário: ${selectedSlot}\`;
&#x20; window\.open(waLink(msg), "\_blank");
});

// Navbar scroll state + mobile menu
const header = document.getElementById('siteHeader');
window\.addEventListener('scroll', ()=>{
&#x20; header.classList.toggle('scrolled', window\.scrollY > 30);
});
const burgerBtn = document.getElementById('burgerBtn');
const navLinks = document.getElementById('navLinks');
burgerBtn.addEventListener('click', ()=> navLinks.classList.toggle('open'));
navLinks.querySelectorAll('a').forEach(a=> a.addEventListener('click', ()=> navLinks.classList.remove('open')));

// Reveal on scroll
const io = new IntersectionObserver((entries)=>{
&#x20; entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:0.15});
document.querySelectorAll('.reveal').forEach(el=> io.observe(el));

// Animated counters
const counters = document.querySelectorAll('[data-count]');
const cio = new IntersectionObserver((entries)=>{
&#x20; entries.forEach(e=>{
&#x20;   if(e.isIntersecting){
&#x20;     const el = e.target;
&#x20;     const target = parseFloat(el.dataset.count);
&#x20;     const decimals = parseInt(el.dataset.decimal || "0");
&#x20;     let cur = 0;
&#x20;     const step = target / 40;
&#x20;     const tick = ()=>{
&#x20;       cur += step;
&#x20;       if(cur >= target){ el.textContent = target.toFixed(decimals); return; }
&#x20;       el.textContent = cur.toFixed(decimals);
&#x20;       requestAnimationFrame(tick);
&#x20;     };
&#x20;     tick();
&#x20;     cio.unobserve(el);
&#x20;   }
&#x20; });
}, {threshold:0.5});
counters.forEach(el=> cio.observe(el));
\</script>

